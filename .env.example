# CatalogWatch configuration. Copy to .env and edit what you need.

# Sent with every request. Point it at your own domain if you prefer.
CATALOGWATCH_USER_AGENT=catalogwatch/1.0 (+https://catalogwatch.dev)

# Seconds per request before it counts as a failure.
CATALOGWATCH_REQUEST_TIMEOUT=20

# Retries on 429/5xx and network errors, with exponential backoff.
CATALOGWATCH_MAX_RETRIES=3
CATALOGWATCH_RETRY_BASE_DELAY=1.0

# Politeness delay between paginated requests, in seconds.
CATALOGWATCH_PAGE_DELAY=0.3

# Optional: Telegram alerts. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
